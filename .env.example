# Accès au panel
ADMIN_PASSWORD=change-moi
SESSION_SECRET=genere-avec-openssl-rand-hex-32

# Domaine du panel (optionnel) : ajouté automatiquement dans le Caddyfile
PANEL_DOMAIN=

# Fin des adresses des projets (affichée dans le formulaire). Vide = domaine complet libre
DOMAIN_SUFFIX=duckdns.org

# Connexion GitHub (optionnel) : liste de tes repos + repos privés
# Option 1 : bouton « Se connecter avec GitHub » → crée une OAuth App sur GitHub
#   (Settings > Developer settings > OAuth Apps > New), coche « Enable Device Flow »,
#   puis mets son Client ID ici
GITHUB_CLIENT_ID=
# Option 2 : coller un token directement dans le panel (rien à mettre ici)
GITHUB_TOKEN=

# Limite mémoire par projet
APP_MEMORY=512m

# Caddy (si le conteneur ou le dossier ne sont pas ceux par défaut)
# CADDY_CONTAINER=caddy
# CADDY_DIR=../caddy

# Avec Caddy en network_mode: host, garde 127.0.0.1 (valeur par défaut)
# BIND_HOST=127.0.0.1
